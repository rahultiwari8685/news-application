{
  "expo": {
    "name": "Top Headlines",
    "slug": "top-headlines",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TH_Logo.png",
    "scheme": "topheadlines",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahultiwari8685.topheadlines"
    },
    "android": {
      "package": "com.rahultiwari8685.topheadlines",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/TH_Logo.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/TH_Logo.png"
    },
  "plugins": [
  "expo-router",

  [
    "expo-splash-screen",
    {
      "image": "./assets/images/TH_Logo.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "backgroundColor": "#000000"
      }
    }
  ],

  [
    "expo-notifications",
    {
      "icon": "./assets/images/notification-icon.png",
      "color": "#E53935"
    }
  ],

  "expo-video",
  "react-native-video"
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a96b8321-a658-470d-8c64-1c0813d39a15"
      }
    }
  }
}
