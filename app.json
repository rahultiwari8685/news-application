{
  "expo": {
    "name": "Bharat19Express",
    "slug": "top-headlines",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/B19_logo.png",
    "scheme": "topheadlines",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahultiwari8685.topheadlines"
    },
   "android": {
  "package": "com.rahultiwari8685.topheadlines",
  "googleServicesFile": "./google-services.json",
  "edgeToEdgeEnabled": true,
  "predictiveBackGestureEnabled": false,
  "adaptiveIcon": {
    "foregroundImage": "./assets/images/B19_adaptive_icon.png",
    "backgroundColor": "#E6F4FE"
  }
},
    
    "web": {
      "output": "static",
      "favicon": "./assets/images/B19_logo.png"
    },
  "plugins": [
  "expo-router",

  [
    "expo-splash-screen",
    {
      "image": "./assets/images/B19_logo.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "backgroundColor": "#000000"
      }
    }
  ],

  "expo-video",
  "react-native-video"
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a96b8321-a658-470d-8c64-1c0813d39a15"
      }
    }
  }
}
